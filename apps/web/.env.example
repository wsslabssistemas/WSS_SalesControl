# Modelo de configuração do app. Copie para `.env.local` e preencha.
# `.env.local` é bloqueado pelo .gitignore.

# Públicos (aparecem no browser — só chaves públicas).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Servidor (NUNCA no browser). Retrieval server-side da biblioteca (P0).
SUPABASE_SERVICE_ROLE_KEY=

# Modelo de IA — necessário para o console reativo.
AI_API_KEY=

# E-mails do fabricante (WSS Labs) com acesso ao painel cross-tenant.
PLATFORM_ADMIN_EMAILS=
