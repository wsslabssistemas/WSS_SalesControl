# ─────────────────────────────────────────────────────────────
# COS — Modelo de configuração. Copie para `.env` e preencha.
# O `.env` real é bloqueado pelo .gitignore e NUNCA sobe pro GitHub.
# Se um segredo vazar em lugar público, troque-o no painel do Supabase.
# ─────────────────────────────────────────────────────────────

# Supabase — referência do projeto (aparece na URL do painel; não é segredo).
SUPABASE_PROJECT_REF=

# Supabase — Personal Access Token (Account → Access Tokens).
# Usado pelo MCP server e pela CLI de management. É SEGREDO.
SUPABASE_ACCESS_TOKEN=

# ── A partir daqui, só passa a valer quando a aplicação Next.js existir ──

# Cliente (vão para o browser — SÓ chaves públicas aqui).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Servidor (NUNCA no browser). Usada no retrieval server-side da biblioteca —
# é a correção do P0 que impede a curadoria de chegar ao trial pelo PostgREST.
SUPABASE_SERVICE_ROLE_KEY=

# Conexão direta do Postgres, para as migrations do Drizzle.
DATABASE_URL=

# Marca isolada em env (decisão do Journal: trocar custa uma linha).
COS_BRAND=WSS Labs
